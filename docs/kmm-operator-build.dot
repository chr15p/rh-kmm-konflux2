
digraph "kmm build and release" {
    
	subgraph cluster_01 { 
		label = <<b>Legend</b>>;
		key [shape=oval label="PR"]
    	key2 [shape=box3d label="build"]
     	}
    
	//splines="ortho"
	//concentrate=true
	rankdir=TB
    /*
	node[shape=box3d color=orange] "fbc-op-414" "fbc-op-415" "fbc-op-416" "fbc-op-417" "fbc-op-418" "fbc-op-419" "fbc-op-420" "fbc-op-421"
	node[shape=box3d color=orange] "fbc-hub-414" "fbc-hub-415" "fbc-hub-416" "fbc-hub-417" "fbc-hub-418" "fbc-hub-419" "fbc-hub-420" "fbc-hub-421"
    */
	node[shape=oval color=red] "external PR"
	node[shape=oval color=red] "operator\nnudge PR" "signing\nnudge PR" "webhook\nnudge PR" "must-gather\nnudge PR" "worker\nnudge PR"  "hub-operator\nnudge PR"
	node[shape=oval color=red] "operator-bundle\nnudge PR" "hub-operator-bundle\nnudge PR"
    {
    rank=same
    //node[shape=plain color=black label="scripts/combine_nudges.py"] merge_one
	node[shape=oval color=red] "combined\noperand nudge PR"
    }
    {
    rank=same
    //node[shape=plain color=black label="scripts/combine_nudges.py"] merge_two
	node[shape=oval color=red] "combined\nbundle nudge PR"
    }
	node[shape=box3d color=orange] "operator-bundle" "hub-operator-bundle"
	node[shape=box3d color=green] "operator" "signing" "webhook" "must-gather" "worker"  "hub-operator"
	node[shape=cds color=blue] "Operands\nrelease"
    {
        edge[color=black splines=straight]
        "external PR"->"operator"
        "external PR"->"signing"
        "external PR"->"webhook" [label="on merge"]
        "external PR"->"must-gather"
        "external PR"->"worker"
        "external PR"->"hub-operator" 
    }
	{
		edge [color=black, concentrate=true, dir=end]
		"operator"->"operator\nnudge PR"
		"signing"->"signing\nnudge PR"
		"webhook"->"webhook\nnudge PR"
		"must-gather"->"must-gather\nnudge PR"
		"worker"->"worker\nnudge PR"
		"hub-operator"->"hub-operator\nnudge PR"
	}
	{
		edge [color=black, concentrate=true, dir=end]
		"operator\nnudge PR"->"combined\noperand nudge PR"
		"signing\nnudge PR"->"combined\noperand nudge PR"
		"webhook\nnudge PR"->"combined\noperand nudge PR" [label="combine_nudges.py"]
		"must-gather\nnudge PR"->"combined\noperand nudge PR"
		"worker\nnudge PR"->"combined\noperand nudge PR"
		"hub-operator\nnudge PR"->"combined\noperand nudge PR"
	}
	{
		edge [color=black, concentrate=true, dir=end]
		"combined\noperand nudge PR"->"operator-bundle" [label="   on merge"]
		"combined\noperand nudge PR"->"hub-operator-bundle"
    }
	{
		edge [color=black, concentrate=true, dir=end]
	    "operator-bundle"->"operator-bundle\nnudge PR"
		"hub-operator-bundle"->"hub-operator-bundle\nnudge PR"
    }
	{
		edge [color=black, concentrate=true, dir=end]
	    "operator-bundle\nnudge PR"->"combined\nbundle nudge PR" [label="combine_nudges.py"]
		"hub-operator-bundle\nnudge PR"->"combined\nbundle nudge PR"
    }

    
	{
		edge [color=black, concentrate=true, dir=end]
        "combined\nbundle nudge PR"->"Operands\nrelease" [label=" release.py"]
	}

