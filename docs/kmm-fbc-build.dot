
digraph "kmm build and release" {
	//splines="ortho"
	//concentrate=true
	rankdir=LR
	node[shape=oval color=red] "combined\nbundle nudge PR"
	node[shape=box3d color=orange] "fbc-op-414" "fbc-op-415" "fbc-op-416" "fbc-op-417" "fbc-op-418" "fbc-op-419" "fbc-op-420" "fbc-op-421"
	node[shape=box3d color=orange] "fbc-hub-414" "fbc-hub-415" "fbc-hub-416" "fbc-hub-417" "fbc-hub-418" "fbc-hub-419" "fbc-hub-420" "fbc-hub-421"
	{
		node[shape = point, height=0, width=0]  "a1" "b1" "c1" "d1" "e1" "f1" "g1" "h1"
		edge [color=black, concentrate=true, dir=none]
		{ rank = same; "a1" "b1" "c1" "d1" "e1" "f1" "g1" "h1"; }
		"a1"->"b1"->"c1"->"d1"->"e1"->"f1"->"g1"->"h1"
		"a1" -> "fbc-op-414"[dir=end]
		"b1" -> "fbc-op-415"[dir=end]
		"c1" -> "fbc-op-416"[dir=end]
		"d1" -> "fbc-op-417"[dir=end]
		"e1" -> "fbc-op-418"[dir=end]
		"f1" -> "fbc-op-419"[dir=end]
		"g1" -> "fbc-op-420"[dir=end]
		"h1" -> "fbc-op-421"[dir=end]
		"combined\nbundle nudge PR"-> "g1" [dir=none]
	}
	{
		node[shape = point, height=0, width=0]  "ah1" "bh1" "ch1" "dh1" "eh1" "fh1" "gh1" "hh1"
		edge [color=black, concentrate=true, dir=none]
		{ rank = same; "ah1" "bh1" "ch1" "dh1" "eh1" "fh1" "gh1" "hh1"; }
		"ah1"->"bh1"->"ch1"->"dh1"->"eh1"->"fh1"->"gh1"->"hh1"
		"ah1" -> "fbc-hub-414"[dir=end]
		"bh1" -> "fbc-hub-415"[dir=end]
		"ch1" -> "fbc-hub-416"[dir=end]
		"dh1" -> "fbc-hub-417"[dir=end]
		"eh1" -> "fbc-hub-418"[dir=end]
		"fh1" -> "fbc-hub-419"[dir=end]
		"gh1" -> "fbc-hub-420"[dir=end]
		"hh1" -> "fbc-hub-421"[dir=end]
		"combined\nbundle nudge PR"-> "dh1" [dir=none label="on merge\n\n\n\n\n\n\n"]
	}
	subgraph cluster_01 { 
		label = <<b>Legend</b>>;
		key [shape=box3d label="item to build"]
   		key2 [shape=cds label="release object"]
   	}
	{
		node[shape = cds]
		edge [color=black, concentrate=true, dir=end]

		"fbc-op-414" -> "fbc-op-414 release"
		"fbc-op-415" -> "fbc-op-415 release"
		"fbc-op-416" -> "fbc-op-416 release"
		"fbc-op-417" -> "fbc-op-417 release"
		"fbc-op-418" -> "fbc-op-418 release"
		"fbc-op-419" -> "fbc-op-419 release"
		"fbc-op-420" -> "fbc-op-420 release"
		"fbc-op-421" -> "fbc-op-421 release"
	}
	{
		node[shape = cds]
		edge [color=black, concentrate=true, dir=end]
		"fbc-hub-414" -> "fbc-hub-414 release" [label="manual\n(release_fbc.py)"]
		"fbc-hub-415" -> "fbc-hub-415 release"
		"fbc-hub-416" -> "fbc-hub-416 release"
		"fbc-hub-417" -> "fbc-hub-417 release"
		"fbc-hub-418" -> "fbc-hub-418 release"
		"fbc-hub-419" -> "fbc-hub-419 release"
		"fbc-hub-420" -> "fbc-hub-420 release"
		"fbc-hub-421" -> "fbc-hub-421 release"
	}

